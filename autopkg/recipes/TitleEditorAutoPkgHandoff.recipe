<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Description</key>
  <string>Generic AutoPkg handoff recipe: run an upstream AutoPkg recipe, then hand off to update_title_editor_versions.sh.</string>

  <key>Identifier</key>
  <string>edu.utah.marriottlibrary.general-scripts.autopkg.TitleEditorAutoPkgHandoff</string>

  <key>Input</key>
  <dict>
    <key>AUTOPKG_CMD</key>
    <string>autopkg</string>

    <key>AUTOPKG_RUN_ARGS</key>
    <string></string>

    <key>HANDOFF_MODE</key>
    <string>signal-only</string>

    <key>SOURCE_RECIPE</key>
    <string>Firefox.munki</string>

    <key>TITLE_EDITOR_EXTRA_ARGS</key>
    <string></string>

    <key>TITLE_EDITOR_ITEM</key>
    <string>firefox</string>

    <key>UPDATE_SCRIPT_PATH</key>
    <string>%RECIPE_DIR%/../../update_title_editor_versions.sh</string>
  </dict>

  <key>MinimumVersion</key>
  <string>2.3</string>

  <key>Process</key>
  <array>
    <dict>
      <key>Processor</key>
      <string>TitleEditorAutoPkgHandoff</string>
    </dict>
  </array>
</dict>
</plist>
